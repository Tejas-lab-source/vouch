{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.js", "**/*.cjs", ".dependency-cruiser.cjs"],
  "exclude": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/test/boundaries/fixtures/**"
  ]
}

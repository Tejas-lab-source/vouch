# Copy to .env for local development. Placeholder values only; never commit .env.
# Every variable is validated by packages/contracts/src/env.js at boot.

# API process
NODE_ENV=development
ROLE=all
PORT=3000
HOST=0.0.0.0
METRICS_PORT=9464
LOG_LEVEL=info
SHUTDOWN_DRAIN_MS=25000
PRIVACY_NOTICE_VERSION=draft

# Identity providers (development adapters; production uses resend and turnstile)
EMAIL_PROVIDER=console
CAPTCHA_PROVIDER=dev
# EMAIL_FROM=no-reply@example.com
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=

# Identity rate limits (ADR 0011). Campuses share one public IP, so per-IP limits are high.
RATE_LIMIT_OTP_EMAIL_15M=3
RATE_LIMIT_OTP_EMAIL_DAY=10
RATE_LIMIT_OTP_IP_HOUR=300
RATE_LIMIT_OTP_DEVICE_HOUR=5
RATE_LIMIT_VERIFY_IP_15M=300
RATE_LIMIT_REFRESH_SESSION_HOUR=60
REFRESH_REUSE_GRACE_SECONDS=30

# Local Postgres (docker compose)
POSTGRES_USER=vouch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vouch
POSTGRES_PORT=5432
# One login per environment, granted every vouch_<module> role (ADR 0010). Locally the compose
# superuser plays that part; SET LOCAL ROLE still limits each module to its own schema.
DATABASE_URL=postgres://vouch:change-me-local-only@localhost:5432/vouch

# Local Redis (docker compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Secrets: local placeholders only (32+ characters). Real values live in the host dashboard.
EMAIL_HMAC_SECRET=local-only-hmac-secret-change-me-0000
COOKIE_SECRET=local-only-cookie-secret-change-me-000

# Access-token keys (Ed25519 JWKs). This public-only placeholder cannot sign tokens:
# run `pnpm dev:keys --write` after copying this file to .env.
JWT_SIGNING_KEYS=[{"kid":"local-dev-1","publicJwk":{"kty":"OKP","crv":"Ed25519","x":"-GIPS7qRHOayoprfUc8DYUT9gyqt36lxEG_BmFA6Z-k"}}]
JWT_ACTIVE_KID=local-dev-1

# Object storage: SeaweedFS locally (docker-compose.yml, infra/seaweedfs/s3.json), Cloudflare R2
# in production. These local credentials match infra/seaweedfs/s3.json; create the bucket once
# with `pnpm storage:init`. Locally the bucket serves photos/ anonymously in place of the CDN.
R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=vouch-local
R2_SECRET_ACCESS_KEY=vouch-local-secret
R2_BUCKET=vouch
CDN_BASE_URL=http://localhost:8333/vouch
STORAGE_PORT=8333

# Photos and uploads (defaults shown)
IMAGE_WORKER_CONCURRENCY=1
PHOTOS_MAX=6
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=600
IMAGE_WEBP_QUALITY=80
IMAGE_MAX_PIXELS=50000000

{
  "name": "@vouch/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Vouch v1 boundary contracts: REST, socket, domain events, jobs, pipelines, config and env, as zod schemas.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./src/index.js",
    "./tooling": "./tooling/index.js"

  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@vouch/config": "workspace:*",
    "eslint": "9.39.5",
    "vitest": "5.1.1"
  }

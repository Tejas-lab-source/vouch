{
  "name": "@vouch/api",
  "version": "0.0.0",
  "private": true,
  "description": "Vouch backend: modular monolith (api, ws, worker roles).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "src/main.js",
  "files": [
    "src",
    "migrations"
  ],
  "scripts": {
    "dev": "node --watch src/main.js",
    "start": "node src/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:invariants": "vitest run --config vitest.invariants.config.js",
    "db:migrate": "node --env-file-if-exists=../../.env migrations/run.js up",
    "db:migrate:down": "node --env-file-if-exists=../../.env migrations/run.js down",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.js",
    "storage:init": "node --env-file-if-exists=../../.env scripts/storage-init.js",
    "bench:deck": "node --env-file-if-exists=../../.env scripts/bench-deck.js",
    "admin:create": "node --env-file-if-exists=../../.env scripts/admin-create.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1175.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@sentry/node": "11.16.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@vouch/contracts": "workspace:*",
    "bullmq": "6.7.8",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.18",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "postgres": "4.1.1",
    "prom-client": "15.1.3",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "@vouch/config": "workspace:*",
    "eslint": "9.39.5",
    "socket.io-client": "4.8.4",
    "vitest": "5.1.1"
  }
}

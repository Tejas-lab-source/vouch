{
  "name": "@vouch/api",
  "version": "0.0.0",
  "private": true,
  "description": "Vouch backend: modular monolith (api, ws, worker roles).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "src/main.js",
  "files": [
    "src",
    "migrations"
  ],
  "scripts": {
    "dev": "node --watch src/main.js",
    "start": "node src/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env migrations/run.js up",
    "db:migrate:down": "node --env-file-if-exists=../../.env migrations/run.js down",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.js"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vouch/config": "workspace:*",
    "eslint": "9.39.5",
    "vitest": "5.1.1"
  }
}
